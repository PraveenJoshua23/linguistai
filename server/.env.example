PORT=3000
GROQ_API_KEY=your_groq_api_key_here
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.jkhzzojucazfgepqnevi.supabase.co:5432/postgres

# Used to verify users' Supabase access tokens (same values as the frontend environment.ts).
SUPABASE_URL=https://jkhzzojucazfgepqnevi.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Qwen-MT translation (Alibaba Cloud Model Studio / DashScope).
# Optional — if DASHSCOPE_API_KEY is unset, translation falls back to Groq.
DASHSCOPE_API_KEY=your_dashscope_api_key_here
# Default is the international (Singapore) endpoint; use
# https://dashscope.aliyuncs.com/compatible-mode/v1 for the Beijing region.
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# qwen-mt-turbo | qwen-mt-plus | qwen-mt-flash | qwen-mt-lite
QWEN_MT_MODEL=qwen-mt-turbo
